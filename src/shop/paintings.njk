---
layout: layouts/base.njk
pageId: shop
titleKey: categories.paintings.name
descriptionKey: categories.paintings.metaDescription
category: paintings
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/shop/paintings/index.html"
---
{% set lang = locale.code %}
{% set categoryProducts = products | byCategory('paintings') %}

<section class="section">
  <div class="container">
    <p><a href="{{ ('/' + lang + '/shop/') | url }}">&larr; {{ 'shop.backToShop' | t(lang) }}</a></p>
    <div class="section-heading section-heading--left">
      <span class="eyebrow">{{ 'nav.shop' | t(lang) }}</span>
      <h1>{{ 'categories.paintings.name' | t(lang) }}</h1>
      <p class="lede">{{ 'categories.paintings.intro' | t(lang) }}</p>
    </div>

    <div class="example-notice">{{ 'common.exampleDataNote' | t(lang) }}</div>

    <div class="grid grid--3">
      {% for product in categoryProducts %}
        {% include "partials/product-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/product-modal.njk" %}
{% include "partials/products-jsonld.njk" %}
