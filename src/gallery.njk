---
layout: layouts/base.njk
pageId: gallery
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/gallery/index.html"
---
{% set lang = locale.code %}

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.gallery' | t(lang) }}</span>
      <h1>{{ 'gallery.title' | t(lang) }}</h1>
      <p class="lede">{{ 'gallery.intro' | t(lang) }}</p>
    </div>

    <h2>{{ 'gallery.finishedTitle' | t(lang) }}</h2>
    <div class="grid grid--4">
      {% for n in [1,2,3,4] %}
      <div class="card__media" style="border-radius: var(--radius-md); border:1px solid var(--color-border);">
        <img src="{{ ('/assets/images/placeholders/gallery-' + n + '.svg') | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" loading="lazy" width="700" height="700">
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.gallery' | t(lang) }}</span>
      <h2>{{ 'gallery.processTitle' | t(lang) }}</h2>
      <p class="lede">{{ 'gallery.processText' | t(lang) }}</p>
    </div>
    <div class="grid grid--2">
      <div class="card__media" style="border-radius: var(--radius-md); border:1px solid var(--color-border);">
        <img src="{{ '/assets/images/placeholders/workshop-1.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" loading="lazy" width="900" height="700">
      </div>
      <div class="card__media" style="border-radius: var(--radius-md); border:1px solid var(--color-border);">
        <img src="{{ '/assets/images/placeholders/workshop-2.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" loading="lazy" width="900" height="700">
      </div>
      <div class="card__media" style="border-radius: var(--radius-md); border:1px solid var(--color-border);">
        <img src="{{ '/assets/images/placeholders/gallery-5.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" loading="lazy" width="700" height="700">
      </div>
      <div class="card__media" style="border-radius: var(--radius-md); border:1px solid var(--color-border);">
        <img src="{{ '/assets/images/placeholders/gallery-6.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" loading="lazy" width="700" height="700">
      </div>
    </div>
  </div>
</section>
