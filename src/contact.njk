---
layout: layouts/base.njk
pageId: contact
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/contact/index.html"
---
{% set lang = locale.code %}

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.contact' | t(lang) }}</span>
      <h1>{{ 'contact.title' | t(lang) }}</h1>
      <p class="lede">{{ 'contact.intro' | t(lang) }}</p>
    </div>

    <div class="contact-layout">
      <form class="form-grid" action="{{ site.formspreeEndpoint }}" method="POST">
        <input type="hidden" name="_language" value="{{ lang }}">
        <div class="form-field">
          <label for="name">{{ 'contact.formName' | t(lang) }}</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-field">
          <label for="email">{{ 'contact.formEmail' | t(lang) }}</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-field">
          <label for="subject">{{ 'contact.formSubject' | t(lang) }}</label>
          <input type="text" id="subject" name="subject" data-contact-subject>
        </div>
        <div class="form-field">
          <label for="message">{{ 'contact.formMessage' | t(lang) }}</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <div>
          <button type="submit" class="btn btn-primary">{{ 'contact.formSubmit' | t(lang) }}</button>
          <p class="image-note">{{ 'contact.formNote' | t(lang) }}</p>
        </div>
      </form>

      <aside class="contact-aside">
        <h2>{{ 'contact.directTitle' | t(lang) }}</h2>
        <p><strong>{{ 'contact.emailLabel' | t(lang) }}:</strong> <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>{{ 'contact.responseTime' | t(lang) }}</p>

        <h2>{{ 'contact.socialTitle' | t(lang) }}</h2>
        <div class="social-list">
          <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
          </a>
          <a href="{{ site.x }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4l16 16M20 4L4 20"/></svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var producto = params.get("producto");
    var subjectField = document.querySelector("[data-contact-subject]");
    if (producto && subjectField) {
      subjectField.value = producto;
    }
  })();
</script>
