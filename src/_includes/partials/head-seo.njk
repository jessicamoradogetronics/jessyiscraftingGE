{% set titleKey = titleKey or (pageId + ".title") %}
{% set descriptionKey = descriptionKey or (pageId + ".metaDescription") %}
{% set pageTitle = titleKey | t(locale.code) %}
{% set pageDescription = descriptionKey | t(locale.code) %}
{% set pageUrl = page.url | url %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}{{ "meta.titleSuffix" | t(locale.code) }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="icon" href="{{ '/assets/images/favicon.svg' | url }}" type="image/svg+xml">
<link rel="canonical" href="{{ site.url }}{{ pageUrl }}">

{% for otherLocale in locales %}
<link rel="alternate" hreflang="{{ otherLocale.code }}" href="{{ site.url }}{{ (page.url | swapLocale(locale.code, otherLocale.code)) | url }}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ (page.url | swapLocale(locale.code, 'es')) | url }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ pageUrl }}">
<meta property="og:image" content="{{ site.url }}{{ '/assets/images/placeholders/og-default.svg' | url }}">
<meta property="og:locale" content="{{ locale.code }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">

<script type="application/ld+json">
{% set logoUrl = site.url + ('/assets/images/favicon.svg' | url) %}
{{ {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.name,
  "url": site.url,
  "logo": logoUrl,
  "sameAs": [site.instagram, site.x]
} | jsonify | safe }}
</script>
