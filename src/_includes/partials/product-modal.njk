<div class="product-modal" data-product-modal aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="product-modal-title">
  <div class="product-modal__backdrop" data-modal-close></div>
  <div class="product-modal__dialog">
    <button type="button" class="product-modal__close" data-modal-close aria-label="{{ 'shop.closeModal' | t(locale.code) }}">&times;</button>
    <div class="product-modal__media">
      <img data-modal-image src="" alt="">
    </div>
    <div>
      <h3 id="product-modal-title" data-modal-title></h3>
      <p data-modal-description></p>
      <p class="price" data-modal-price></p>
      <div data-modal-customization-wrap hidden>
        <strong>{{ 'shop.customizationTitle' | t(locale.code) }}:</strong>
        <p data-modal-customization></p>
      </div>
      <a class="btn btn-gold" data-modal-cta href="#">{{ 'shop.ctaInquire' | t(locale.code) }}</a>
    </div>
  </div>
</div>
