{% set productsJsonLd = [] %}
{% for product in categoryProducts %}
  {% set _ = productsJsonLd.push({
    "@type": "Product",
    "name": product.name | tr(lang),
    "description": product.description | tr(lang),
    "image": site.url + (product.image | url),
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": product.price,
      "availability": "https://schema.org/InStock"
    }
  }) %}
{% endfor %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": productsJsonLd
} | jsonify | safe }}
</script>
