{% set productName = product.name | tr(locale.code) %}
{% set productDesc = product.description | tr(locale.code) %}
{% set productCustomNote = product.customizationNote | tr(locale.code) %}
{% set contactHref = (('/' + locale.code + '/contact/') | url) + '?producto=' + (productName | urlencode) %}
<article class="card" data-product
  data-image="{{ product.image | url }}"
  data-name="{{ productName }}"
  data-description="{{ productDesc }}"
  data-price-label="{% if product.priceFrom %}{{ 'shop.fromPriceLabel' | t(locale.code) }} {% endif %}{{ product.price | formatPrice }}"
  data-customization="{{ productCustomNote }}"
  data-cta-href="{{ contactHref }}">
  <div class="card__media">
    <img src="{{ product.image | url }}" alt="{{ productName }}" loading="lazy" width="800" height="600">
  </div>
  <div class="card__body">
    <div>
      {% if product.isExample %}<span class="badge">{{ 'shop.exampleBadge' | t(locale.code) }}</span>{% endif %}
      {% if product.customizable %}<span class="badge badge--customizable">{{ 'shop.customizableLabel' | t(locale.code) }}</span>{% endif %}
    </div>
    <h3 class="card__title">{{ productName }}</h3>
    <p class="card__desc">{{ productDesc }}</p>
    <div class="card__footer">
      <span class="price">{% if product.priceFrom %}<small>{{ 'shop.fromPriceLabel' | t(locale.code) }}</small> {% endif %}{{ product.price | formatPrice }}</span>
      <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
        <button type="button" class="btn btn-outline btn-sm" data-open-modal>{{ 'shop.viewDetails' | t(locale.code) }}</button>
        <a class="btn btn-gold btn-sm" href="{{ contactHref }}">{{ 'shop.ctaInquire' | t(locale.code) }}</a>
      </div>
    </div>
  </div>
</article>
