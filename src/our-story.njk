---
layout: layouts/base.njk
pageId: ourStory
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/our-story/index.html"
---
{% set lang = locale.code %}

<section class="section">
  <div class="container story-layout">
    <div>
      <div class="story-portrait">
        <img src="{{ '/assets/images/placeholders/portrait-founder.svg' | url }}" alt="{{ 'ourStory.photoCaption' | t(lang) }}" width="900" height="1100">
      </div>
      <p class="image-note">{{ 'ourStory.photoCaption' | t(lang) }}</p>
    </div>
    <div>
      <span class="eyebrow">{{ 'ourStory.eyebrow' | t(lang) }}</span>
      <h1>{{ 'ourStory.heading' | t(lang) }}</h1>
      {% for paragraph in ('ourStory.paragraphs' | t(lang)) %}
      <p>{{ paragraph }}</p>
      {% endfor %}
      <p class="pull-quote">{{ 'ourStory.quote' | t(lang) }}</p>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-heading">
      <h2>{{ 'ourStory.valuesTitle' | t(lang) }}</h2>
    </div>
    <div class="grid grid--3 values-grid">
      {% for value in ('ourStory.values' | t(lang)) %}
      <div class="card">
        <div class="card__body">
          <h3 class="card__title">{{ value.title }}</h3>
          <p class="card__desc">{{ value.text }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
