---
layout: layouts/base.njk
pageId: home
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/index.html"
eleventyExcludeFromCollections: false
---
{% set lang = locale.code %}

<section class="hero container">
  <div class="hero__content">
    <span class="eyebrow">{{ 'home.heroEyebrow' | t(lang) }}</span>
    <h1>{{ 'home.heroTitle' | t(lang) }}</h1>
    <p class="lede">{{ 'home.heroSubtitle' | t(lang) }}</p>
    <div class="hero__actions">
      <a class="btn btn-primary" href="{{ ('/' + lang + '/shop/') | url }}">{{ 'home.heroCtaShop' | t(lang) }}</a>
      <a class="btn btn-outline" href="{{ ('/' + lang + '/gallery/') | url }}">{{ 'home.heroCtaGallery' | t(lang) }}</a>
    </div>
  </div>
  <div class="hero__media">
    <img src="{{ '/assets/images/placeholders/hero-main.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" width="1200" height="900">
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ site.name }}</span>
      <h2>{{ 'home.quickLinksTitle' | t(lang) }}</h2>
    </div>
    <div class="grid grid--4">
      <a class="quick-link-card" href="{{ ('/' + lang + '/shop/') | url }}">
        <span class="quick-link-card__icon" aria-hidden="true">🛍️</span>
        <h3>{{ 'home.quickLinks.shop.title' | t(lang) }}</h3>
        <p>{{ 'home.quickLinks.shop.description' | t(lang) }}</p>
      </a>
      <a class="quick-link-card" href="{{ ('/' + lang + '/gallery/') | url }}">
        <span class="quick-link-card__icon" aria-hidden="true">🖼️</span>
        <h3>{{ 'home.quickLinks.gallery.title' | t(lang) }}</h3>
        <p>{{ 'home.quickLinks.gallery.description' | t(lang) }}</p>
      </a>
      <a class="quick-link-card" href="{{ ('/' + lang + '/collaborations/') | url }}">
        <span class="quick-link-card__icon" aria-hidden="true">🤝</span>
        <h3>{{ 'home.quickLinks.collaborations.title' | t(lang) }}</h3>
        <p>{{ 'home.quickLinks.collaborations.description' | t(lang) }}</p>
      </a>
      <a class="quick-link-card" href="{{ ('/' + lang + '/inspiration/') | url }}">
        <span class="quick-link-card__icon" aria-hidden="true">🌲</span>
        <h3>{{ 'home.quickLinks.inspiration.title' | t(lang) }}</h3>
        <p>{{ 'home.quickLinks.inspiration.description' | t(lang) }}</p>
      </a>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container story-layout">
    <div class="story-portrait">
      <img src="{{ '/assets/images/placeholders/workshop-1.svg' | url }}" alt="{{ 'common.placeholderImageNote' | t(lang) }}" width="900" height="700">
    </div>
    <div>
      <span class="eyebrow">{{ 'ourStory.eyebrow' | t(lang) }}</span>
      <h2>{{ 'home.introTitle' | t(lang) }}</h2>
      <p class="lede">{{ 'home.introText' | t(lang) }}</p>
      <a class="btn btn-primary" href="{{ ('/' + lang + '/our-story/') | url }}">{{ 'home.introCta' | t(lang) }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.shop' | t(lang) }}</span>
      <h2>{{ 'home.featuredTitle' | t(lang) }}</h2>
    </div>
    <div class="grid grid--4">
      {% for category in ['crafts', 'digitalArt', 'paintings', 'figures'] %}
        {% set featured = (products | byCategory(category)) | first %}
        {% if featured %}
        <article class="card">
          <div class="card__media">
            <img src="{{ featured.image | url }}" alt="{{ featured.name | tr(lang) }}" loading="lazy" width="800" height="600">
          </div>
          <div class="card__body">
            <h3 class="card__title">{{ featured.name | tr(lang) }}</h3>
            <div class="card__footer">
              <span class="price">{{ featured.price | formatPrice }}</span>
              <a class="btn btn-outline btn-sm" href="{{ ('/' + lang + '/shop/' + (category | lower | replace('digitalart','digital-art')) + '/') | url }}">{{ 'shop.viewCategory' | t(lang) }}</a>
            </div>
          </div>
        </article>
        {% endif %}
      {% endfor %}
    </div>
    <p class="text-center" style="margin-top:2rem;">
      <a class="btn btn-primary" href="{{ ('/' + lang + '/shop/') | url }}">{{ 'home.featuredCta' | t(lang) }}</a>
    </p>
  </div>
</section>
