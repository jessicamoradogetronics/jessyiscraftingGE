---
layout: layouts/base.njk
pageId: faq
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/faq/index.html"
---
{% set lang = locale.code %}

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.faq' | t(lang) }}</span>
      <h1>{{ 'faq.title' | t(lang) }}</h1>
      <p class="lede">{{ 'faq.intro' | t(lang) }}</p>
    </div>

    <div style="max-width:780px; margin-inline:auto;">
      {% for item in ('faq.items' | t(lang)) %}
      <div class="accordion-item" data-accordion-item data-open="{% if loop.first %}true{% else %}false{% endif %}">
        <h2 style="margin:0;">
          <button type="button" class="accordion-trigger" data-accordion-trigger aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">
            <span>{{ item.question }}</span>
            <span class="accordion-trigger__icon" aria-hidden="true">+</span>
          </button>
        </h2>
        <div class="accordion-panel">
          <div class="accordion-panel__inner">
            <p>{{ item.answer }}</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
