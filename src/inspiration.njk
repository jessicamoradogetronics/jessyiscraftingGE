---
layout: layouts/base.njk
pageId: inspiration
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale.code }}/inspiration/index.html"
---
{% set lang = locale.code %}

<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'nav.inspiration' | t(lang) }}</span>
      <h1>{{ 'inspiration.title' | t(lang) }}</h1>
      <p class="lede">{{ 'inspiration.intro' | t(lang) }}</p>
    </div>

    <div class="story-layout">
      <div>
        <div class="story-portrait">
          <img src="{{ '/assets/images/placeholders/gallery-5.svg' | url }}" alt="{{ 'inspiration.kcdTitle' | t(lang) }}" width="700" height="700">
        </div>
      </div>
      <div>
        <h2>{{ 'inspiration.kcdTitle' | t(lang) }}</h2>
        <p>{{ 'inspiration.kcdText1' | t(lang) }}</p>
        <p>{{ 'inspiration.kcdText2' | t(lang) }}</p>
      </div>
    </div>

    <div class="divider" aria-hidden="true">❧</div>

    <div class="story-layout">
      <div>
        <h2>{{ 'inspiration.readingTitle' | t(lang) }}</h2>
        <p>{{ 'inspiration.readingText' | t(lang) }}</p>
        <a class="btn btn-gold" href="{{ site.fanficUrl }}" target="_blank" rel="noopener noreferrer">{{ 'inspiration.fanficCta' | t(lang) }}</a>
        <p class="image-note">{{ 'inspiration.fanficNote' | t(lang) }}</p>
      </div>
      <div>
        <div class="story-portrait">
          <img src="{{ '/assets/images/placeholders/gallery-6.svg' | url }}" alt="{{ 'inspiration.readingTitle' | t(lang) }}" width="700" height="700">
        </div>
      </div>
    </div>
  </div>
</section>
